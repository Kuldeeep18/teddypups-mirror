b:T988,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are your puppies vaccinated and health-checked?","acceptedAnswer":{"@type":"Answer","text":"Yes. All our puppies come with a verified health certificate from licensed vets. Every puppy is vaccinated, dewormed, and thoroughly checked before joining your family."}},{"@type":"Question","name":"Can I meet a puppy before I decide?","acceptedAnswer":{"@type":"Answer","text":"Yes. Come meet our locally available puppies in our Downtown Dubai showroom and spend time bonding before making your decision."}},{"@type":"Question","name":"Can I take my puppy home the same day?","acceptedAnswer":{"@type":"Answer","text":"Local puppies are available immediately, so you can take your puppy home the same day."}},{"@type":"Question","name":"Do you import puppies from abroad?","acceptedAnswer":{"@type":"Answer","text":"Yes. Through our Order Upon Request service we source rare and premium teacup breeds from the most reputable, certified breeders across Europe, Korea, and beyond â€” and we handle the import for you."}},{"@type":"Question","name":"How does an imported puppy travel to Dubai?","acceptedAnswer":{"@type":"Answer","text":"We manage every part of the import process, including health checks, travel arrangements, and the necessary documentation, so your puppy arrives happy, healthy, and stress-free."}},{"@type":"Question","name":"Will I see photos and health details first?","acceptedAnswer":{"@type":"Answer","text":"Yes. Photos, videos, and health certificates are shared before your puppy travels, and our team sends real photos and health details directly on WhatsApp."}},{"@type":"Question","name":"Do you deliver?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver within Dubai, and our trusted international cargo partners deliver puppies safely to loving homes all around the world."}},{"@type":"Question","name":"Which breeds do you usually have?","acceptedAnswer":{"@type":"Answer","text":"Breeds we regularly have include Maltipoo, Pomeranian, Poodle and Bichon, plus rare teacup lines such as Korean teacup poodles, Maltese, Pom and Yorkie."}},{"@type":"Question","name":"Is there help after my puppy comes home?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our team is available 24/7 and offers advice on training, nutrition, and general care to ensure a smooth transition for you and your new furry friend."}}]}10:X
