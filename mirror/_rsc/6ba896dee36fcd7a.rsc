36:T988,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are your puppies vaccinated and health-checked?","acceptedAnswer":{"@type":"Answer","text":"Yes. All our puppies come with a verified health certificate from licensed vets. Every puppy is vaccinated, dewormed, and thoroughly checked before joining your family."}},{"@type":"Question","name":"Can I meet a puppy before I decide?","acceptedAnswer":{"@type":"Answer","text":"Yes. Come meet our locally available puppies in our Downtown Dubai showroom and spend time bonding before making your decision."}},{"@type":"Question","name":"Can I take my puppy home the same day?","acceptedAnswer":{"@type":"Answer","text":"Local puppies are available immediately, so you can take your puppy home the same day."}},{"@type":"Question","name":"Do you import puppies from abroad?","acceptedAnswer":{"@type":"Answer","text":"Yes. Through our Order Upon Request service we source rare and premium teacup breeds from the most reputable, certified breeders across Europe, Korea, and beyond — and we handle the import for you."}},{"@type":"Question","name":"How does an imported puppy travel to Dubai?","acceptedAnswer":{"@type":"Answer","text":"We manage every part of the import process, including health checks, travel arrangements, and the necessary documentation, so your puppy arrives happy, healthy, and stress-free."}},{"@type":"Question","name":"Will I see photos and health details first?","acceptedAnswer":{"@type":"Answer","text":"Yes. Photos, videos, and health certificates are shared before your puppy travels, and our team sends real photos and health details directly on WhatsApp."}},{"@type":"Question","name":"Do you deliver?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver within Dubai, and our trusted international cargo partners deliver puppies safely to loving homes all around the world."}},{"@type":"Question","name":"Which breeds do you usually have?","acceptedAnswer":{"@type":"Answer","text":"Breeds we regularly have include Maltipoo, Pomeranian, Poodle and Bichon, plus rare teacup lines such as Korean teacup poodles, Maltese, Pom and Yorkie."}},{"@type":"Question","name":"Is there help after my puppy comes home?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our team is available 24/7 and offers advice on training, nutrition, and general care to ensure a smooth transition for you and your new furry friend."}}]}e:["$","div",null,{"data-page":"faq","className":"tp-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$36"}}],["$","section",null,{"data-pup-scene":true,"data-tone":"dark","className":"tp-scene tp-faqroom overflow-hidden","style":{"--sky-top":"#a95e32","--sky-bottom":"#331c11"},"aria-labelledby":"faq-title","children":[["$","div",null,{"className":"gutter relative mx-auto max-w-[110rem] pb-24 pt-10 md:pt-16","children":[["$","header",null,{"className":"max-w-4xl","children":[["$","h1",null,{"id":"faq-title","className":"font-plush text-giant","children":"Questions & answers"}],["$","p",null,{"className":"text-lede mt-6 max-w-[52ch] text-[var(--ink-soft)]","children":"Can't find what you're looking for? Message us on WhatsApp — our team is available 24/7."}]]}],["$","div",null,{"className":"mt-12 md:mt-16","children":["$","$L38",null,{"faqs":[{"id":"2bcfc70e-8c06-475d-aa8a-2b64932d30cc","question":"Are your puppies vaccinated and health-checked?","answer":"Yes. All our puppies come with a verified health certificate from licensed vets. Every puppy is vaccinated, dewormed, and thoroughly checked before joining your family."},{"id":"45fb5252-c038-41c7-afae-c8478b8f4f76","question":"Can I meet a puppy before I decide?","answer":"Yes. Come meet our locally available puppies in our Downtown Dubai showroom and spend time bonding before making your decision."},{"id":"9585fb34-9d0d-4ee3-a903-38442633135d","question":"Can I take my puppy home the same day?","answer":"Local puppies are available immediately, so you can take your puppy home the same day."},{"id":"bd85389d-2116-4c4b-8500-0a5a82cae22c","question":"Do you import puppies from abroad?","answer":"Yes. Through our Order Upon Request service we source rare and premium teacup breeds from the most reputable, certified breeders across Europe, Korea, and beyond — and we handle the import for you."},{"id":"9c865c5e-bd1e-4bd3-9c09-cf193923123e","question":"How does an imported puppy travel to Dubai?","answer":"We manage every part of the import process, including health checks, travel arrangements, and the necessary documentation, so your puppy arrives happy, healthy, and stress-free."},{"id":"18483536-4415-4cc9-8ef8-913421f9da89","question":"Will I see photos and health details first?","answer":"Yes. Photos, videos, and health certificates are shared before your puppy travels, and our team sends real photos and health details directly on WhatsApp."},{"id":"653f64ec-6e3a-4e3a-b4ab-8862b96fd123","question":"Do you deliver?","answer":"Yes. We deliver within Dubai, and our trusted international cargo partners deliver puppies safely to loving homes all around the world."},{"id":"c7990450-8c87-47f5-9ebe-1490c7f47ffa","question":"Which breeds do you usually have?","answer":"Breeds we regularly have include Maltipoo, Pomeranian, Poodle and Bichon, plus rare teacup lines such as Korean teacup poodles, Maltese, Pom and Yorkie."},{"id":"67b95211-ac7c-4582-a684-90fcd4e00812","question":"Is there help after my puppy comes home?","answer":"Yes. Our team is available 24/7 and offers advice on training, nutrition, and general care to ensure a smooth transition for you and your new furry friend."}],"askHref":"https://wa.me/971541676733?text=Hi%20TeddyPups!%20I%20have%20a%20question%3A"}]}]]}],false]}]]}]
